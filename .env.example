# HTTP listen address for the API server
API_ADDR=:8080

# SQLite database file path (shared by API and worker in local dev)
DB_PATH=./data/securelink.db

# AWS / S3 / SQS configuration
AWS_REGION=us-east-1
S3_BUCKET=securelink-files
SQS_QUEUE_URL=http://localhost:4566/000000000000/securelink-events

# Set to a LocalStack endpoint (e.g. http://localhost:4566) for local dev.
# Leave empty to use real AWS endpoints.
AWS_ENDPOINT_URL=http://localhost:4566

# Local dev only: LocalStack accepts any non-empty static credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Presigned URL lifetimes, in seconds
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

# Worker polling behavior
SQS_WAIT_TIME_SECONDS=10
SQS_MAX_MESSAGES=5
